# Supabase project settings → API
# (the anon key is safe for the browser — every table is protected by
# Row Level Security, so a signed-in parent can only ever touch their own rows)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Anthropic Console → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional — defaults to claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5
